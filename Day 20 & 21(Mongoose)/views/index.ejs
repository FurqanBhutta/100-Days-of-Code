<%- include('header') %>

    <form action="/" method="post">
        <div class="mb-3">
            <label for="name" class="form-label">Name:</label>
            <input type="text" class="form-control" id="name" name="name">
        </div>
        <div class="mb-3">
            <label for="color" class="form-label">Color:</label>
            <input type="text" class="form-control" id="color" name="color">
        </div>
        <div class="mb-3">
            <label for="price" class="form-label">Price:</label>
            <input type="number" class="form-control" id="price" name="price">
        </div>
        <button type="submit" class="btn btn-primary">Add Car</button>
    </form>

    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Names</th>
                <th scope="col">Colors</th>
                <th scope="col">Prices</th>
                <th scope="col">Opt.</th>
            </tr>
        </thead>
        <tbody>
            <% for (const [index , car] of cars.entries()) { %>
                <tr>
                    <th scope="row">
                        <%= index+1 %>
                    </th>
                    <td>
                        <%=car.name%>
                    </td>
                    <td>
                        <%=car.color%>
                    </td>
                    <td>
                        <%=car.price%>
                    </td>
                    <td>
                        <form action="/delete" method="post" class="d-inline">
                            <button name="myID" value="<%=car._id%>" class="btn btn-danger" onclick="this.form.submit()">Delete</button>
                        </form>
                        <form action="/update/<%=car._id%>" method="get" class="d-inline">
                            <button name="myID" value="<%=car._id%>" class="btn btn-success" onclick="this.form.submit()">Update</button>
                        </form>
                    </td>
                </tr>
                <%}%>
        </tbody>
    </table>


<%- include('footer') %>
